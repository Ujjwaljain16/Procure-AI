# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Gemini (google-genai SDK) -- required for architecture="single"
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash if unset. gemini-3.8-flash is also
# supported but was observed returning transient 503 "high demand" errors on
# the free tier at implementation time -- override here once that clears up.
GEMINI_MODEL=
