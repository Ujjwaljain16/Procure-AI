# Reference only. The application reads configuration from the process environment, not from this file.
# Set the variables in your shell (for example `export GEMINI_API_KEY=...`) before starting the app.

# Local vendor-risk mock (loopback)
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Direct Gemini (architecture A and B, through the Gemini SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini through CloseRouter (OpenAI-compatible endpoint); used by --provider closerouter
CLOSEROUTER_API_KEY=
CLOSEROUTER_MODEL=google/gemini-3.7-flash
